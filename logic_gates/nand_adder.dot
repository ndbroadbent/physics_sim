digraph NAND_Adder {
  rankdir=LR;
  nodesep=0.5;
  ranksep=1.2;
  splines=ortho;
  bgcolor="#000000";
  compound=true;
  node [fontname="Helvetica", fontcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10, color="#ffffff", fontcolor="#ffffff"];
  subgraph cluster_0_inputs {
    label="Inputs"; fontcolor="#ffffff";
    style=filled; color="#222222"; bgcolor="#111111";
    Cin0 [label="Cin0=0", shape=square, fontcolor="#ffffff", fillcolor="#444444"];
    A0 [label="A0", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B0 [label="B0", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A1 [label="A1", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B1 [label="B1", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A2 [label="A2", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B2 [label="B2", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A3 [label="A3", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B3 [label="B3", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A4 [label="A4", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B4 [label="B4", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A5 [label="A5", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B5 [label="B5", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A6 [label="A6", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B6 [label="B6", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    A7 [label="A7", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    B7 [label="B7", style=filled, fillcolor="#444444", shape=circle, fontcolor="#ffffff"];
    edge [style=invis];
    Cin0 -> A0;
    A0 -> A1;
    B0 -> B1;
    A1 -> A2;
    B1 -> B2;
    A2 -> A3;
    B2 -> B3;
    A3 -> A4;
    B3 -> B4;
    A4 -> A5;
    B4 -> B5;
    A5 -> A6;
    B5 -> B6;
    A6 -> A7;
    B6 -> B7;
    edge [style=solid];
  }
  subgraph cluster_1_adders {
    label="Full Adders Stack"; fontcolor="#ffffff";
    style=filled; color="#444444"; bgcolor="#222222";
    node [shape=box, style=filled, fillcolor="#662222", label="NAND", height=0.3, width=0.6, fontcolor="#ffffff"];
    subgraph cluster_bit_0 {
      label="Bit 0"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b0_ha1_n1;
    b0_c1;
    b0_ha1_n2;
    b0_ha1_n3;
    b0_s1;
    b0_ha2_n1;
    b0_c2;
    b0_ha2_n2;
    b0_ha2_n3;
    b0_S;
    b0_or_n1;
    b0_or_n2;
    b0_Cout;
      A0 -> b0_ha1_n1; B0 -> b0_ha1_n1;
      b0_ha1_n1 -> b0_c1; b0_ha1_n1 -> b0_c1;
      A0 -> b0_ha1_n2; b0_ha1_n1 -> b0_ha1_n2;
      B0 -> b0_ha1_n3; b0_ha1_n1 -> b0_ha1_n3;
      b0_ha1_n2 -> b0_s1; b0_ha1_n3 -> b0_s1;
      b0_s1 -> b0_ha2_n1; Cin0 -> b0_ha2_n1;
      b0_ha2_n1 -> b0_c2; b0_ha2_n1 -> b0_c2;
      b0_s1 -> b0_ha2_n2; b0_ha2_n1 -> b0_ha2_n2;
      Cin0 -> b0_ha2_n3; b0_ha2_n1 -> b0_ha2_n3;
      b0_ha2_n2 -> b0_S; b0_ha2_n3 -> b0_S;
      b0_c1 -> b0_or_n1; b0_c1 -> b0_or_n1;
      b0_c2 -> b0_or_n2; b0_c2 -> b0_or_n2;
      b0_or_n1 -> b0_Cout; b0_or_n2 -> b0_Cout;
    }
    subgraph cluster_bit_1 {
      label="Bit 1"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b1_ha1_n1;
    b1_c1;
    b1_ha1_n2;
    b1_ha1_n3;
    b1_s1;
    b1_ha2_n1;
    b1_c2;
    b1_ha2_n2;
    b1_ha2_n3;
    b1_S;
    b1_or_n1;
    b1_or_n2;
    b1_Cout;
      A1 -> b1_ha1_n1; B1 -> b1_ha1_n1;
      b1_ha1_n1 -> b1_c1; b1_ha1_n1 -> b1_c1;
      A1 -> b1_ha1_n2; b1_ha1_n1 -> b1_ha1_n2;
      B1 -> b1_ha1_n3; b1_ha1_n1 -> b1_ha1_n3;
      b1_ha1_n2 -> b1_s1; b1_ha1_n3 -> b1_s1;
      b1_s1 -> b1_ha2_n1; b0_Cout -> b1_ha2_n1 [constraint=false, color="#00bfff"];
      b1_ha2_n1 -> b1_c2; b1_ha2_n1 -> b1_c2;
      b1_s1 -> b1_ha2_n2; b1_ha2_n1 -> b1_ha2_n2;
      b0_Cout -> b1_ha2_n3 [constraint=false, color="#00bfff"]; b1_ha2_n1 -> b1_ha2_n3;
      b1_ha2_n2 -> b1_S; b1_ha2_n3 -> b1_S;
      b1_c1 -> b1_or_n1; b1_c1 -> b1_or_n1;
      b1_c2 -> b1_or_n2; b1_c2 -> b1_or_n2;
      b1_or_n1 -> b1_Cout; b1_or_n2 -> b1_Cout;
    }
    subgraph cluster_bit_2 {
      label="Bit 2"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b2_ha1_n1;
    b2_c1;
    b2_ha1_n2;
    b2_ha1_n3;
    b2_s1;
    b2_ha2_n1;
    b2_c2;
    b2_ha2_n2;
    b2_ha2_n3;
    b2_S;
    b2_or_n1;
    b2_or_n2;
    b2_Cout;
      A2 -> b2_ha1_n1; B2 -> b2_ha1_n1;
      b2_ha1_n1 -> b2_c1; b2_ha1_n1 -> b2_c1;
      A2 -> b2_ha1_n2; b2_ha1_n1 -> b2_ha1_n2;
      B2 -> b2_ha1_n3; b2_ha1_n1 -> b2_ha1_n3;
      b2_ha1_n2 -> b2_s1; b2_ha1_n3 -> b2_s1;
      b2_s1 -> b2_ha2_n1; b1_Cout -> b2_ha2_n1 [constraint=false, color="#00bfff"];
      b2_ha2_n1 -> b2_c2; b2_ha2_n1 -> b2_c2;
      b2_s1 -> b2_ha2_n2; b2_ha2_n1 -> b2_ha2_n2;
      b1_Cout -> b2_ha2_n3 [constraint=false, color="#00bfff"]; b2_ha2_n1 -> b2_ha2_n3;
      b2_ha2_n2 -> b2_S; b2_ha2_n3 -> b2_S;
      b2_c1 -> b2_or_n1; b2_c1 -> b2_or_n1;
      b2_c2 -> b2_or_n2; b2_c2 -> b2_or_n2;
      b2_or_n1 -> b2_Cout; b2_or_n2 -> b2_Cout;
    }
    subgraph cluster_bit_3 {
      label="Bit 3"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b3_ha1_n1;
    b3_c1;
    b3_ha1_n2;
    b3_ha1_n3;
    b3_s1;
    b3_ha2_n1;
    b3_c2;
    b3_ha2_n2;
    b3_ha2_n3;
    b3_S;
    b3_or_n1;
    b3_or_n2;
    b3_Cout;
      A3 -> b3_ha1_n1; B3 -> b3_ha1_n1;
      b3_ha1_n1 -> b3_c1; b3_ha1_n1 -> b3_c1;
      A3 -> b3_ha1_n2; b3_ha1_n1 -> b3_ha1_n2;
      B3 -> b3_ha1_n3; b3_ha1_n1 -> b3_ha1_n3;
      b3_ha1_n2 -> b3_s1; b3_ha1_n3 -> b3_s1;
      b3_s1 -> b3_ha2_n1; b2_Cout -> b3_ha2_n1 [constraint=false, color="#00bfff"];
      b3_ha2_n1 -> b3_c2; b3_ha2_n1 -> b3_c2;
      b3_s1 -> b3_ha2_n2; b3_ha2_n1 -> b3_ha2_n2;
      b2_Cout -> b3_ha2_n3 [constraint=false, color="#00bfff"]; b3_ha2_n1 -> b3_ha2_n3;
      b3_ha2_n2 -> b3_S; b3_ha2_n3 -> b3_S;
      b3_c1 -> b3_or_n1; b3_c1 -> b3_or_n1;
      b3_c2 -> b3_or_n2; b3_c2 -> b3_or_n2;
      b3_or_n1 -> b3_Cout; b3_or_n2 -> b3_Cout;
    }
    subgraph cluster_bit_4 {
      label="Bit 4"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b4_ha1_n1;
    b4_c1;
    b4_ha1_n2;
    b4_ha1_n3;
    b4_s1;
    b4_ha2_n1;
    b4_c2;
    b4_ha2_n2;
    b4_ha2_n3;
    b4_S;
    b4_or_n1;
    b4_or_n2;
    b4_Cout;
      A4 -> b4_ha1_n1; B4 -> b4_ha1_n1;
      b4_ha1_n1 -> b4_c1; b4_ha1_n1 -> b4_c1;
      A4 -> b4_ha1_n2; b4_ha1_n1 -> b4_ha1_n2;
      B4 -> b4_ha1_n3; b4_ha1_n1 -> b4_ha1_n3;
      b4_ha1_n2 -> b4_s1; b4_ha1_n3 -> b4_s1;
      b4_s1 -> b4_ha2_n1; b3_Cout -> b4_ha2_n1 [constraint=false, color="#00bfff"];
      b4_ha2_n1 -> b4_c2; b4_ha2_n1 -> b4_c2;
      b4_s1 -> b4_ha2_n2; b4_ha2_n1 -> b4_ha2_n2;
      b3_Cout -> b4_ha2_n3 [constraint=false, color="#00bfff"]; b4_ha2_n1 -> b4_ha2_n3;
      b4_ha2_n2 -> b4_S; b4_ha2_n3 -> b4_S;
      b4_c1 -> b4_or_n1; b4_c1 -> b4_or_n1;
      b4_c2 -> b4_or_n2; b4_c2 -> b4_or_n2;
      b4_or_n1 -> b4_Cout; b4_or_n2 -> b4_Cout;
    }
    subgraph cluster_bit_5 {
      label="Bit 5"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b5_ha1_n1;
    b5_c1;
    b5_ha1_n2;
    b5_ha1_n3;
    b5_s1;
    b5_ha2_n1;
    b5_c2;
    b5_ha2_n2;
    b5_ha2_n3;
    b5_S;
    b5_or_n1;
    b5_or_n2;
    b5_Cout;
      A5 -> b5_ha1_n1; B5 -> b5_ha1_n1;
      b5_ha1_n1 -> b5_c1; b5_ha1_n1 -> b5_c1;
      A5 -> b5_ha1_n2; b5_ha1_n1 -> b5_ha1_n2;
      B5 -> b5_ha1_n3; b5_ha1_n1 -> b5_ha1_n3;
      b5_ha1_n2 -> b5_s1; b5_ha1_n3 -> b5_s1;
      b5_s1 -> b5_ha2_n1; b4_Cout -> b5_ha2_n1 [constraint=false, color="#00bfff"];
      b5_ha2_n1 -> b5_c2; b5_ha2_n1 -> b5_c2;
      b5_s1 -> b5_ha2_n2; b5_ha2_n1 -> b5_ha2_n2;
      b4_Cout -> b5_ha2_n3 [constraint=false, color="#00bfff"]; b5_ha2_n1 -> b5_ha2_n3;
      b5_ha2_n2 -> b5_S; b5_ha2_n3 -> b5_S;
      b5_c1 -> b5_or_n1; b5_c1 -> b5_or_n1;
      b5_c2 -> b5_or_n2; b5_c2 -> b5_or_n2;
      b5_or_n1 -> b5_Cout; b5_or_n2 -> b5_Cout;
    }
    subgraph cluster_bit_6 {
      label="Bit 6"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b6_ha1_n1;
    b6_c1;
    b6_ha1_n2;
    b6_ha1_n3;
    b6_s1;
    b6_ha2_n1;
    b6_c2;
    b6_ha2_n2;
    b6_ha2_n3;
    b6_S;
    b6_or_n1;
    b6_or_n2;
    b6_Cout;
      A6 -> b6_ha1_n1; B6 -> b6_ha1_n1;
      b6_ha1_n1 -> b6_c1; b6_ha1_n1 -> b6_c1;
      A6 -> b6_ha1_n2; b6_ha1_n1 -> b6_ha1_n2;
      B6 -> b6_ha1_n3; b6_ha1_n1 -> b6_ha1_n3;
      b6_ha1_n2 -> b6_s1; b6_ha1_n3 -> b6_s1;
      b6_s1 -> b6_ha2_n1; b5_Cout -> b6_ha2_n1 [constraint=false, color="#00bfff"];
      b6_ha2_n1 -> b6_c2; b6_ha2_n1 -> b6_c2;
      b6_s1 -> b6_ha2_n2; b6_ha2_n1 -> b6_ha2_n2;
      b5_Cout -> b6_ha2_n3 [constraint=false, color="#00bfff"]; b6_ha2_n1 -> b6_ha2_n3;
      b6_ha2_n2 -> b6_S; b6_ha2_n3 -> b6_S;
      b6_c1 -> b6_or_n1; b6_c1 -> b6_or_n1;
      b6_c2 -> b6_or_n2; b6_c2 -> b6_or_n2;
      b6_or_n1 -> b6_Cout; b6_or_n2 -> b6_Cout;
    }
    subgraph cluster_bit_7 {
      label="Bit 7"; style=rounded; color="#bbbbbb"; bgcolor="#333322"; fontcolor="#ffffff";
    b7_ha1_n1;
    b7_c1;
    b7_ha1_n2;
    b7_ha1_n3;
    b7_s1;
    b7_ha2_n1;
    b7_c2;
    b7_ha2_n2;
    b7_ha2_n3;
    b7_S;
    b7_or_n1;
    b7_or_n2;
    b7_Cout;
      A7 -> b7_ha1_n1; B7 -> b7_ha1_n1;
      b7_ha1_n1 -> b7_c1; b7_ha1_n1 -> b7_c1;
      A7 -> b7_ha1_n2; b7_ha1_n1 -> b7_ha1_n2;
      B7 -> b7_ha1_n3; b7_ha1_n1 -> b7_ha1_n3;
      b7_ha1_n2 -> b7_s1; b7_ha1_n3 -> b7_s1;
      b7_s1 -> b7_ha2_n1; b6_Cout -> b7_ha2_n1 [constraint=false, color="#00bfff"];
      b7_ha2_n1 -> b7_c2; b7_ha2_n1 -> b7_c2;
      b7_s1 -> b7_ha2_n2; b7_ha2_n1 -> b7_ha2_n2;
      b6_Cout -> b7_ha2_n3 [constraint=false, color="#00bfff"]; b7_ha2_n1 -> b7_ha2_n3;
      b7_ha2_n2 -> b7_S; b7_ha2_n3 -> b7_S;
      b7_c1 -> b7_or_n1; b7_c1 -> b7_or_n1;
      b7_c2 -> b7_or_n2; b7_c2 -> b7_or_n2;
      b7_or_n1 -> b7_Cout; b7_or_n2 -> b7_Cout;
    }
    edge [style=invis];
    b0_Cout -> b1_Cout;
    b0_ha1_n1 -> b1_ha1_n1;
    b1_Cout -> b2_Cout;
    b1_ha1_n1 -> b2_ha1_n1;
    b2_Cout -> b3_Cout;
    b2_ha1_n1 -> b3_ha1_n1;
    b3_Cout -> b4_Cout;
    b3_ha1_n1 -> b4_ha1_n1;
    b4_Cout -> b5_Cout;
    b4_ha1_n1 -> b5_ha1_n1;
    b5_Cout -> b6_Cout;
    b5_ha1_n1 -> b6_ha1_n1;
    b6_Cout -> b7_Cout;
    b6_ha1_n1 -> b7_ha1_n1;
    edge [style=solid];
  }
  subgraph cluster_2_outputs {
    label="Output Sum"; fontcolor="#ffffff";
    style=filled; color="#222266"; bgcolor="#111133";
    node [shape=doublecircle, style=filled, fillcolor="#226622", fontcolor="#ffffff"];
    S0 [label="S0"];
    S1 [label="S1"];
    S2 [label="S2"];
    S3 [label="S3"];
    S4 [label="S4"];
    S5 [label="S5"];
    S6 [label="S6"];
    S7 [label="S7"];
    edge [style=invis];
    S0 -> S1;
    S1 -> S2;
    S2 -> S3;
    S3 -> S4;
    S4 -> S5;
    S5 -> S6;
    S6 -> S7;
    edge [style=solid];
  }
  b0_S -> S0;
  b1_S -> S1;
  b2_S -> S2;
  b3_S -> S3;
  b4_S -> S4;
  b5_S -> S5;
  b6_S -> S6;
  b7_S -> S7;
}