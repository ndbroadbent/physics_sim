digraph NAND_Adder {
  newrank=true;
  rankdir=LR;
  nodesep=0.5;
  ranksep=0.8;
  splines=ortho;
  node [fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  subgraph cluster_inputs {
    label="Inputs";
    style=filled; color="#f0f0f0";
    subgraph cluster_A {
      label="Input A";
      style=filled; color="#ffffff";
      node [style=filled, fillcolor="#e0e0e0", shape=circle];
      A0 [label="A0"];
      A1 [label="A1"];
      A2 [label="A2"];
      A3 [label="A3"];
      A4 [label="A4"];
      A5 [label="A5"];
      A6 [label="A6"];
      A7 [label="A7"];
      A0 -> A1 [style=invis, weight=100];
      A1 -> A2 [style=invis, weight=100];
      A2 -> A3 [style=invis, weight=100];
      A3 -> A4 [style=invis, weight=100];
      A4 -> A5 [style=invis, weight=100];
      A5 -> A6 [style=invis, weight=100];
      A6 -> A7 [style=invis, weight=100];
    }
    subgraph cluster_B {
      label="Input B";
      style=filled; color="#ffffff";
      node [style=filled, fillcolor="#e0e0e0", shape=circle];
      B0 [label="B0"];
      B1 [label="B1"];
      B2 [label="B2"];
      B3 [label="B3"];
      B4 [label="B4"];
      B5 [label="B5"];
      B6 [label="B6"];
      B7 [label="B7"];
      B0 -> B1 [style=invis, weight=100];
      B1 -> B2 [style=invis, weight=100];
      B2 -> B3 [style=invis, weight=100];
      B3 -> B4 [style=invis, weight=100];
      B4 -> B5 [style=invis, weight=100];
      B5 -> B6 [style=invis, weight=100];
      B6 -> B7 [style=invis, weight=100];
    }
    Cin0 [label="Cin0=0", shape=square];
  }
  { rank=source; Cin0; A0; A1; A2; A3; A4; A5; A6; A7; B0; B1; B2; B3; B4; B5; B6; B7; }
  subgraph cluster_S {
    label="Output Sum";
    style=filled; color="#d0e0ff";
    node [shape=doublecircle, style=filled, fillcolor="#c0f0c0"];
    S0 [label="S0"];
    S1 [label="S1"];
    S2 [label="S2"];
    S3 [label="S3"];
    S4 [label="S4"];
    S5 [label="S5"];
    S6 [label="S6"];
    S7 [label="S7"];
    S0 -> S1 [style=invis, weight=100];
    S1 -> S2 [style=invis, weight=100];
    S2 -> S3 [style=invis, weight=100];
    S3 -> S4 [style=invis, weight=100];
    S4 -> S5 [style=invis, weight=100];
    S5 -> S6 [style=invis, weight=100];
    S6 -> S7 [style=invis, weight=100];
  }
  { rank=sink; S0; S1; S2; S3; S4; S5; S6; S7; }
  // NAND Gates
  node [shape=box, style=filled, fillcolor="#ffcccc", label="NAND", height=0.3, width=0.6];
  subgraph cluster_bit_0 {
    label="Bit 0"; style=dotted; color="#aaaaaa";
  b0_ha1_n1;
    A0 -> b0_ha1_n1;
    B0 -> b0_ha1_n1;
  b0_ha1_n2;
